<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TheUnknowing</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\</OutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- $(VINTAGE_STORY) is the modding convention's standard env var for the game install dir
       (used by CI, see .github/workflows/theunknowing.yml) - falls back to this machine's local
       install when unset. -->
  <PropertyGroup>
    <VintagestoryDir Condition="'$(VINTAGE_STORY)' != ''">$(VINTAGE_STORY)</VintagestoryDir>
    <VintagestoryDir Condition="'$(VintagestoryDir)' == ''">C:\Users\DJRic\AppData\Roaming\Vintagestory</VintagestoryDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintagestoryDir)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintagestoryDir)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VintagestoryDir)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- EntityShapeRenderer (TheUnknowingRenderer's base class) lives here, not in VintagestoryAPI. -->
    <Reference Include="VSEssentials">
      <HintPath>$(VintagestoryDir)\Mods\VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintagestoryDir)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintagestoryDir)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VintagestoryDir)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Optional soft dependency (see TheUnknowingModSystem.HookConfigLib) - vendored here only
         because ConfigLib isn't part of the base game install, so there's no stable HintPath to
         reference like the game's own DLLs above. Private=false: never copied into our own output,
         relies entirely on the player/server's already-installed ConfigLib mod at runtime. -->
    <Reference Include="configlib">
      <HintPath>lib\configlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
